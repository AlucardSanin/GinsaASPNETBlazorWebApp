@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var t = SiteContent.CurrentValue;
    var h = t.Hero;
    var calendlyOnclick = $"Calendly.initPopupWidget({{url: '{t.CalendlyUrl}'}});return false;";
}
<header class="hero">
    <img class="decor decor--curl-l" src="@Assets["images/curl1.svg"]" alt="" aria-hidden="true" />
    <img class="decor decor--curl-r" src="@Assets["images/curl2.svg"]" alt="" aria-hidden="true" />
    <img class="decor decor--hexagon" src="@Assets["images/hexagon.svg"]" alt="" aria-hidden="true" />
    <img class="decor decor--periwinkle-a" src="@Assets["images/quote-curl.svg"]" alt="" aria-hidden="true" />
    <img class="decor decor--periwinkle-b" src="@Assets["images/quote-curl.svg"]" alt="" aria-hidden="true" />
    <img class="decor decor--quote" src="@Assets["images/quote-right.svg"]" alt="" aria-hidden="true" />

    <div class="container hero__inner">
        <div class="hero__brand">
            <img class="hero__intro" src="@Assets["images/hero-intro.gif"]" alt="We are Arrieta Agency" />
        </div>

        <p class="hero__headline">
            <span class="hero__headline-main">@h.TituloLinea1</span>
            <span class="hero__headline-block">
                <span class="hero__headline-main">@h.TituloLinea2</span>
                <span class="hero__headline-sub" aria-label="@h.Subtitulo">
                    @foreach (var ch in h.Subtitulo)
                    {
                        <span aria-hidden="true">@(ch == ' ' ? "\u00A0" : ch.ToString())</span>
                    }
                </span>
            </span>
        </p>

        <div class="hero__cta">
            <a class="btn-cta hero__calendly"
               href="@t.CalendlyUrl"
               onclick="@calendlyOnclick">@h.BotonCalendly</a>
        </div>
    </div>
</header>
