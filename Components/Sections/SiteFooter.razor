@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var t = SiteContent.CurrentValue;
    var f = t.Footer;
    var c = t.Contacto;
    var telCo = c.TelefonoColombia.Replace(" ", "");
    var telVe = c.TelefonoVenezuela.Replace(" ", "");
}
<footer class="site-footer" id="footer">
    <div class="container">
        <img class="site-footer__mark reveal reveal--scale" src="@Assets["images/smile.svg"]" alt="Arrieta Agency" />

        <div class="site-footer__cols reveal d1">
            <div class="footer-col">
                <p class="h">@f.TituloCorreo</p>
                <a class="v" href="mailto:@c.Email">
                    <img src="@Assets["images/icon-mail.svg"]" alt="" />
                    <span>@c.Email</span>
                </a>
            </div>
            <div class="footer-col">
                <p class="h">@f.TituloInstagram</p>
                <a class="v" href="@c.InstagramUrl" target="_blank" rel="noopener">
                    <img src="@Assets["images/icon-instagram.svg"]" alt="" />
                    <span>@c.Instagram</span>
                </a>
            </div>
            <div class="footer-col">
                <p class="h">@f.TituloVenezuela</p>
                <a class="v" href="tel:@telVe">
                    <img class="flag" src="@Assets["images/flag-ve.svg"]" alt="" />
                    <span>@c.TelefonoVenezuela</span>
                </a>
            </div>
            <div class="footer-col">
                <p class="h">@f.TituloColombia</p>
                <a class="v" href="tel:@telCo">
                    <img class="flag" src="@Assets["images/flag-co.svg"]" alt="" />
                    <span>@c.TelefonoColombia</span>
                </a>
            </div>
        </div>

        <p class="site-footer__copy">
            @f.Copyright
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a class="site-footer__legal" href="/privacidad">@f.EnlacePrivacidad</a>
        </p>
    </div>
</footer>
