@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var p = SiteContent.CurrentValue.Proceso;
    var pasos = p.Pasos;
}
<section class="proceso" id="proceso" data-step="0" tabindex="0" aria-label="¿Cómo lo hacemos? Carrusel de pasos">
    <div class="proceso__bgs" aria-hidden="true">
        <div class="proceso__bg proceso__bg--0 is-active"></div>
        <div class="proceso__bg proceso__bg--1"></div>
        <div class="proceso__bg proceso__bg--2"></div>
        <div class="proceso__bg proceso__bg--3"></div>
        <div class="proceso__bg proceso__bg--4"></div>
        <div class="proceso__noise"></div>
    </div>

    <div class="container">
        <h2 class="section-title proceso__title reveal"><span class="fun">@p.TituloResaltado</span>@p.TituloDespues</h2>
    </div>

    <div class="proceso__stage reveal d1" role="list">
        @for (var i = 0; i < pasos.Count && i < StepMeta.Length; i++)
        {
            var paso = pasos[i];
            var meta = StepMeta[i];
            var active = i == 0;
            var cardClass = active ? $"step-card {meta.Css} is-active" : $"step-card {meta.Css}";
            <article class="@cardClass" data-step="@i" role="listitem" aria-current="@(active ? "true" : null)">
                <div class="step-card__body">
                    <h3 class="step-card__title"><span class="num">@paso.Numero</span>@paso.Titulo</h3>
                    <p class="step-card__text">@((MarkupString)paso.Texto)</p>
                </div>
                <div class="step-card__art"><img src="@Assets[meta.Img]" alt="" draggable="false" /></div>
            </article>
        }
    </div>
</section>

@code {
    private static readonly (string Css, string Img)[] StepMeta =
    [
        ("step-card--yellow", "images/ear-te-escuchamos.png"),
        ("step-card--green", "images/card-proponemos.png"),
        ("step-card--blue step-card--creamos", "images/card-creamos.png"),
        ("step-card--purple step-card--ejecutamos", "images/card-ejecutamos.png"),
        ("step-card--dark step-card--medimos", "images/card-medimos.png"),
    ];
}
