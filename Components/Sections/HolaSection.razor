@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var t = SiteContent.CurrentValue;
    var h = t.Hola;
    var calendlyOnclick = $"Calendly.initPopupWidget({{url: '{t.CalendlyUrl}'}});return false;";
}
<section class="hola" id="hola">
    <div class="container hola__grid">
        <div class="hola__content">
            <h2 class="hola__title reveal reveal--left">@h.Titulo</h2>

            <div class="hola__text reveal reveal--left d1">
                @foreach (var p in h.Parrafos)
                {
                    <p>@p</p>
                }
            </div>

            <a class="btn-cta hola__cta reveal reveal--left d2"
               href="@t.CalendlyUrl"
               onclick="@calendlyOnclick">@h.Boton</a>
        </div>

        <div class="hola__people reveal reveal--right d1">
            <img class="hola__curl" src="@Assets["images/curl4.svg"]" alt="" aria-hidden="true" />
            <img class="hola__burst" src="@Assets["images/burst-red.svg"]" alt="" aria-hidden="true" />
            <img class="ginsa" src="@Assets["images/person-ginsa.png"]" alt="Ginsa" />
            <img class="hernedy" src="@Assets["images/person-hernedy.png"]" alt="Hernedy" />
            <img class="hola__wave" src="@Assets["images/wave-purple.svg"]" alt="" aria-hidden="true" />
        </div>
    </div>
</section>
