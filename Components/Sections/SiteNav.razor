@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var n = SiteContent.CurrentValue.Navegacion;
}
<nav class="site-nav">
    <input type="checkbox" id="navToggle" class="nav-check" hidden />
    <div class="container">
        <a href="/" class="nav-logo" aria-label="Arrieta Agency">
            <img src="@Assets["images/logo-arrieta-agency.svg"]" alt="Arrieta Agency" />
        </a>

        <div class="nav-links">
            <a href="/#hola">@n.QuienesSomos</a>
            <a href="/#servicios">@n.Servicios</a>
            <a href="/#proceso">@n.Proceso</a>
            <a href="/portafolio">@n.Portafolio</a>
        </div>

        <label for="navToggle" class="nav-toggle" aria-label="Abrir menú">
            <span></span><span></span><span></span>
        </label>
        <a class="btn-cta" href="/#footer">@n.Contactanos</a>
    </div>
</nav>
