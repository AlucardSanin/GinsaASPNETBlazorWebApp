@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var t = SiteContent.CurrentValue;
    var c = t.Creemos;
    var contacto = t.Contacto;
}
<section class="creemos" id="creemos">
    <div class="container">
        <div class="creemos__brand reveal reveal--scale" aria-label="Creemos juntos" data-creemos-logo>
            <img class="creemos__logo creemos__logo--base"
                 src="@Assets["images/creemos-juntos.svg"]"
                 alt="Creemos juntos"
                 width="620"
                 height="288" />
        </div>
        <p class="creemos__text reveal d1">
            @c.Texto
        </p>
        <div class="country-row reveal d2">
            <a class="country-btn on-dark"
               href="https://wa.me/@contacto.WhatsAppColombia"
               target="_blank"
               rel="noopener noreferrer">
                <img class="flag" src="@Assets["images/flag-co.svg"]" alt="" />
                <span class="label">@c.BotonColombia</span>
                <img class="arrow" src="@Assets["images/icon-arrow.svg"]" alt="" />
            </a>
            <a class="country-btn on-dark"
               href="https://wa.me/@contacto.WhatsAppVenezuela"
               target="_blank"
               rel="noopener noreferrer">
                <img class="flag" src="@Assets["images/flag-ve.svg"]" alt="" />
                <span class="label">@c.BotonVenezuela</span>
                <img class="arrow" src="@Assets["images/icon-arrow.svg"]" alt="" />
            </a>
        </div>
    </div>
</section>
