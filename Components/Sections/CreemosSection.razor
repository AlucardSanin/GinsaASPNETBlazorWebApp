<section class="creemos" id="creemos">
    <div class="container">
        <img class="creemos__logo reveal reveal--scale" src="@Assets["images/creemos-juntos.svg"]" alt="Creemos juntos" />
        <p class="creemos__text reveal d1">
            Si tienes una idea en mente o te gustaría conocer más de nuestros servicios, ¡contáctanos!
        </p>
        <div class="country-row reveal d2">
            <a class="country-btn on-dark"
               href="https://wa.me/573002414506"
               target="_blank"
               rel="noopener noreferrer">
                <img class="flag" src="@Assets["images/flag-co.svg"]" alt="" />
                <span class="label">Colombia</span>
                <img class="arrow" src="@Assets["images/icon-arrow.svg"]" alt="" />
            </a>
            <a class="country-btn on-dark"
               href="https://wa.me/584246172813"
               target="_blank"
               rel="noopener noreferrer">
                <img class="flag" src="@Assets["images/flag-ve.svg"]" alt="" />
                <span class="label">Venezuela</span>
                <img class="arrow" src="@Assets["images/icon-arrow.svg"]" alt="" />
            </a>
            <a class="country-btn on-dark"
               href="https://calendly.com/agenciarrieta/30min"
               onclick="Calendly.initPopupWidget({url: 'https://calendly.com/agenciarrieta/30min'});return false;">
                <img class="flag" src="@Assets["images/smile.svg"]" alt="" />
                <span class="label">Hagamos equipo</span>
                <img class="arrow" src="@Assets["images/icon-arrow.svg"]" alt="" />
            </a>
        </div>
    </div>
</section>
