@inject IOptionsMonitor<SiteContent> SiteContent
@{
    var n = SiteContent.CurrentValue.Numeros;
    var notaLineas = n.Nota.Replace("\r\n", "\n").Split('\n');
}
<section class="numeros" id="numeros" aria-label="@n.Titulo">
    <div class="container">
        <h2 class="section-title numeros__title reveal">@n.Titulo</h2>

        <div class="numeros__grid">
            @for (var i = 0; i < n.Items.Count && i < KpiIcons.Length; i++)
            {
                var item = n.Items[i];
                var itemClass = i == 0 ? "numeros__item reveal" : $"numeros__item reveal d{i}";
                <article class="@itemClass">
                    <span class="numeros__icon" aria-hidden="true">
                        <img class="numeros__icon-still" src="@Assets[KpiIcons[i]]" alt="" width="64" height="64" />
                        <img class="numeros__icon-anim" src="@Assets[KpiGifs[i]]" alt="" width="64" height="64" loading="lazy" />
                    </span>
                    <p class="numeros__value">@item.Valor</p>
                    <p class="numeros__lead"><strong>@item.Destacado</strong></p>
                    <p class="numeros__sub">@item.Detalle</p>
                </article>
            }
        </div>

        <p class="numeros__note reveal d5">
            @for (var i = 0; i < notaLineas.Length; i++)
            {
                @notaLineas[i]
                if (i < notaLineas.Length - 1)
                {
                    <br />
                }
            }
        </p>
    </div>
</section>

@code {
    private static readonly string[] KpiIcons =
    [
        "images/numeros/seedling.png",
        "images/numeros/rocket-launch.png",
        "images/numeros/envelope.png",
        "images/numeros/heart.png",
        "images/numeros/user.png",
    ];

    private static readonly string[] KpiGifs =
    [
        "images/numeros/seedling-hover.gif",
        "images/numeros/rocket-hover.gif",
        "images/numeros/envelope-hover.gif",
        "images/numeros/heart-hover.gif",
        "images/numeros/user-hover.gif",
    ];
}
